NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
DATA_DIR=.data
# Production: generate secrets before deployment. Local development generates private persistent keys.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
SQLITE_PATH=
# SMTP supports any recipient including Gmail. Gmail sender requires an app password/OAuth setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Empty keys keep the clearly marked demo catalog and rule-based finder.
JAMENDO_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# IaaS reverse proxy only (see docs/DEPLOYMENT.md).
DOMAIN=
